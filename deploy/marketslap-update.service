# Pull the latest code, so deploying is a git push and nothing else.
#
# THIS IS WHAT KEEPS THE PROJECT PHONE-WORKABLE. Without it, every code
# change needs an SSH session; with it, pushing to main is the deploy.
# The recorders cycle hourly, so new code is live within the hour with
# no manual step.
#
# The repo is public, so this needs no credential. `git reset --hard`
# rather than `git pull`, because a merge conflict on an unattended box
# is a recorder that silently stops.
#
# IT UPDATES THE REPO, NOT THE MACHINE, and that used to be the end of
# the story. This runs as `marketslap`, which has no business writing to
# /etc, so unit files stayed whatever bootstrap.sh copied once and a
# .service change landed in git to be ignored by the running box.
#
# marketslap-sync.service closes that. It runs After= this one, as root,
# and syncs deploy/marketslap-*.service into /etc/systemd/system. The
# split is deliberate: pulling from a public repo stays unprivileged,
# and only the copy into /etc is root.
#
# The m15 recorder's source stamp still reads systemd's INVOCATION_ID
# rather than an Environment= line, and should stay that way — deriving
# a fact from the runtime beats configuring it in two places even when
# both can deploy.

[Unit]
Description=MarketSlap self-update from git
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=marketslap
WorkingDirectory=/opt/marketslap
ExecStart=/usr/bin/git fetch --quiet origin main
ExecStart=/usr/bin/git reset --hard --quiet origin/main
