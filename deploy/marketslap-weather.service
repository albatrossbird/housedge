# The weather recorder, as a long-lived service.
#
# WHY A SERVICE AND NOT A TIMER. On GitHub Actions this job runs for 330
# minutes at a stretch, because GitHub does not honour short crons —
# this repo asks for */30 and measures gaps of 45 minutes to 3.5 hours,
# so long overlapping runs were the only way to approach continuous
# coverage. It is also the single largest consumer of Actions minutes
# here, and the last thing keeping this repository public.
#
# A machine we control has no such problem. Restart=always plus a
# modest RUN_MINUTES gives genuinely continuous coverage, and the
# process cycling every hour is also what lets new code land without a
# deploy step — marketslap-update.timer pulls, and the next cycle runs
# the new code.
#
# NEITHER HALF OF THIS DATASET CAN BE BACKFILLED, which is why it is
# Restart=always rather than best effort. A settled Kalshi market
# reports one last price, and NWS serves the CURRENT forecast, never
# the one it was issuing yesterday afternoon. The whole question the
# table exists for — was Kalshi mispriced against what was knowable at
# the time — needs both sides stamped from before the outcome was
# known. A day not recorded is gone.
#
# THE RESTART IS NOT FREE, and the cost is worth stating rather than
# discovering. Write-on-change is held in memory, so the first tick
# after every restart has no baseline and writes the whole ladder —
# about one extra full sweep per hour. That is a few thousand rows a
# day against a table that is otherwise mostly quiet, and it buys
# code updates landing within the hour.

[Unit]
Description=MarketSlap weather market recorder
After=network-online.target
Wants=network-online.target

# CRASH-LOOP LIMIT, AND IT LIVES IN [Unit] — systemd moved these out of
# [Service] and IGNORES them there. Ours were in [Service] and the
# journal said so on every reload:
#
#   Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring
#
# So the limit did not exist. That matters because Restart=always is
# deliberate here — a recorder must survive a bad response from a venue,
# since the price path cannot be backfilled — and the ONLY thing making
# that safe is a ceiling on how many times it may restart. Without it, a
# permanent fault restarts forever: the 15-minute recorder spent
# fourteen hours re-running against a rejected credential, warning every
# fifteen seconds, and nothing ever escalated.
#
# Ten starts in five minutes, then systemd gives up and the unit sits
# failed, which is visible in `systemctl status` and never self-clears.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=marketslap
WorkingDirectory=/opt/marketslap
EnvironmentFile=/etc/marketslap/env
# One hour per cycle. Short enough that a code update lands promptly,
# long enough that restarts are not the dominant activity.
Environment=WX_RUN_MINUTES=60
ExecStart=/usr/bin/node scripts/wx-record.mjs
Restart=always
RestartSec=5

# The box holds a service-role key. Give the unit no more than it needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/marketslap

[Install]
WantedBy=multi-user.target
