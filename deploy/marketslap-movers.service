# The home page's movers and most-traded lists, across Kalshi, Polymarket
# US and polymarket.com. Reads the three venues' public data and writes
# the `movers` table (migration 0035); /api/movers serves it.
#
# A venue whose read does not complete keeps its previous rows and the
# unit ends `failed`, visible in `systemctl status` and the journal.
#
# Needs no npm install: the script reads and writes Supabase over REST.
# Uses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from the env file.
#
# MEASURED from a sandbox, 2026-11-27: Polymarket ~8s, the Kalshi sweep
# 104 pages in ~60s, the .us list 140 pages in ~60s, one after another:
# ~2 minutes a run. Nice=10 like
# the refresh, because the recorders share this machine.

[Unit]
Description=MarketSlap movers and most-traded lists
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=marketslap
WorkingDirectory=/opt/marketslap
EnvironmentFile=/etc/marketslap/env
# The heap cap makes Node collect garbage early. The first run, with
# the three venues read at once and no cap, was OOM-killed at the 400MB
# MemoryMax 3s in (2026-11-27). Measured since, reading them one at a
# time: peak RSS 385MB without the cap, 285MB with it, same output.
ExecStart=/usr/bin/node --max-old-space-size=160 scripts/movers.mjs
# A normal run is ~5 minutes on the box (2026-11-27). Killed at 13, under
# the 15-minute interval, so a hung run never piles up.
TimeoutStartSec=780
Nice=10
MemoryMax=400M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
