{
  "version": 1,
  "platform": "kalshi",
  "strategy_name": "momentum-ladder-small-200",
  "market": {
    "series_ticker": "KXBTC15M"
  },
  "risk": {
    "max_position": 200,
    "price_floor": 0.01,
    "price_ceiling": 0.99
  },
  "loop": {
    "interval": 10
  },
  "edge": {
    "btc": {
      "provider": "coinbase",
      "symbol": "BTC-USD",
      "fields": [
        "price",
        "vwap_1h",
        "change_5m",
        "ema_12_1m",
        "high_15m",
        "low_15m",
        "velocity_1m",
        "sma_20_1m"
      ],
      "refresh": "5s"
    }
  },
  "rules": [
    {
      "name": "position_limit",
      "when": {
        "all": [
          {
            "field": "position_size",
            "op": ">",
            "value": 200
          }
        ]
      },
      "action": "skip"
    },
    {
      "name": "take_profit_per_contract",
      "when": {
        "all": [
          {
            "field": "unrealized_pnl_per_contract",
            "op": ">",
            "value": 0.266666667
          }
        ]
      },
      "action": "sell_all"
    },
    {
      "name": "stop_loss_per_contract",
      "when": {
        "all": [
          {
            "field": "unrealized_pnl_per_contract",
            "op": "<",
            "value": -0.5
          },
          {
            "field": "price",
            "op": ">=",
            "value": 0.15
          },
          {
            "field": "price",
            "op": "<=",
            "value": 0.85
          }
        ]
      },
      "action": "sell_all"
    },
    {
      "name": "buy_yes_above_vwap",
      "when": {
        "all": [
          {
            "field": "position_size",
            "op": "==",
            "value": 0
          },
          {
            "field": "time_to_expiry",
            "op": "<=",
            "value": "5m"
          },
          {
            "field": "edge.btc.price",
            "op": ">",
            "value_field": "edge.btc.vwap_1h"
          },
          {
            "field": "edge.btc.price",
            "op": ">",
            "value_field": "edge.btc.ema_12_1m"
          },
          {
            "field": "edge.btc.change_5m",
            "op": ">",
            "value": 0.001
          },
          {
            "field": "edge.btc.velocity_1m",
            "op": ">",
            "value": 0
          },
          {
            "field": "price",
            "op": ">=",
            "value": 0.35
          },
          {
            "field": "price",
            "op": "<=",
            "value": 0.65
          },
          {
            "field": "spread",
            "op": "<=",
            "value": 0.015
          }
        ]
      },
      "action": "buy_yes",
      "size": 200
    },
    {
      "name": "buy_no_below_vwap",
      "when": {
        "all": [
          {
            "field": "position_size",
            "op": "==",
            "value": 0
          },
          {
            "field": "time_to_expiry",
            "op": "<=",
            "value": "5m"
          },
          {
            "field": "edge.btc.price",
            "op": "<",
            "value_field": "edge.btc.vwap_1h"
          },
          {
            "field": "edge.btc.price",
            "op": "<",
            "value_field": "edge.btc.ema_12_1m"
          },
          {
            "field": "edge.btc.change_5m",
            "op": "<",
            "value": -0.001
          },
          {
            "field": "edge.btc.velocity_1m",
            "op": "<",
            "value": 0
          },
          {
            "field": "price",
            "op": ">=",
            "value": 0.35
          },
          {
            "field": "price",
            "op": "<=",
            "value": 0.65
          },
          {
            "field": "spread",
            "op": "<=",
            "value": 0.015
          }
        ]
      },
      "action": "buy_no",
      "size": 200
    },
    {
      "name": "accel_momentum_yes",
      "when": {
        "all": [
          {
            "field": "position_size",
            "op": "==",
            "value": 0
          },
          {
            "field": "time_to_expiry",
            "op": "<=",
            "value": "5m"
          },
          {
            "field": "edge.btc.change_5m",
            "op": ">",
            "value": 0.0015
          },
          {
            "field": "edge.btc.velocity_1m",
            "op": ">",
            "value": 0
          },
          {
            "field": "price",
            "op": ">=",
            "value": 0.2
          },
          {
            "field": "price",
            "op": "<=",
            "value": 0.8
          },
          {
            "field": "spread",
            "op": "<=",
            "value": 0.015
          }
        ]
      },
      "action": "buy_yes",
      "size": 200
    },
    {
