          },
          {
            "field": "time_to_expiry",
            "op": "<=",
            "value": "5m"
          },
          {
            "field": "price",
            "op": "<=",
            "value": 0.12
          },
          {
            "field": "spread",
            "op": "<=",
            "value": 0.03
          }
        ]
      },
      "action": "buy_no",
      "size": 200
    }
  ]
}
