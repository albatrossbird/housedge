          },
          {
            "field": "time_to_expiry",
            "op": "<=",
            "value": "5m"
          },
          {
            "field": "price",
            "op": ">=",
            "value": 0.88
          },
          {
            "field": "spread",
            "op": "<=",
            "value": 0.03
          }
        ]
      },
      "action": "buy_yes",
      "size": 200
    },
    {
      "name": "late_momentum_no",
      "when": {
        "all": [
          {
            "field": "position_size",
            "op": "==",
