            "value": -0.0015
          },
          {
            "field": "edge.btc.velocity_1m",
            "op": "<",
            "value": 0
          },
          {
            "field": "price",
            "op": ">=",
            "value": 0.2
          },
          {
            "field": "price",
            "op": "<=",
            "value": 0.8
          },
          {
            "field": "spread",
            "op": "<=",
            "value": 0.015
          }
        ]
      },
      "action": "buy_no",
      "size": 200
    },
    {
      "name": "early_entry_yes",
      "when": {
        "all": [
          {
            "field": "position_size",
            "op": "==",
            "value": 0
          },
          {
            "field": "time_to_expiry",
            "op": "<=",
            "value": "5m"
          },
          {
            "field": "price",
            "op": ">=",
            "value": 0.4
          },
          {
            "field": "price",
            "op": "<=",
            "value": 0.6
          },
          {
            "field": "edge.btc.change_5m",
            "op": ">",
            "value": 0
          },
          {
            "field": "edge.btc.velocity_1m",
            "op": ">",
            "value": 0
          },
          {
            "field": "edge.btc.price",
            "op": ">",
            "value_field": "edge.btc.vwap_1h"
          },
          {
            "field": "edge.btc.ema_12_1m",
            "op": ">",
